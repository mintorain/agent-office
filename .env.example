# Tavily API key (optional) — enables Tavily web search for agents.
# When set, web_search calls use Tavily; otherwise DuckDuckGo is used as fallback.
# Get your key at https://app.tavily.com
TAVILY_API_KEY=

# LLM Backend Settings
# Providers: 'ollama' or 'openai' (which is OpenAICompatible)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# OpenAI or Gemini (with OpenAI compatibility) API key
OPENAI_API_KEY=
# API Base URL. Default for OpenAI is https://api.openai.com/v1
# If using Gemini (OpenAI Compatible), set to https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_API_BASE=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434
